{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gino",
  "version": "../package.json",
  "identifier": "com.gino.stretch",
  "build": {
    "frontendDist": "../build/web",
    "beforeDevCommand": { "script": "npm run build", "wait": true },
    "beforeBuildCommand": "npm run build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "Gino Desk Stretch",
    "homepage": "https://github.com/sim2390/gino-desk-stretch",
    "copyright": "Copyright (c) 2026 sim2390",
    "license": "MIT",
    "category": "HealthcareAndFitness",
    "shortDescription": "A desk stretch coach that lives in your tray",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.3",
      "signingIdentity": "-"
    }
  }
}
