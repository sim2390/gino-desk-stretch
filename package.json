{
  "name": "gino",
  "productName": "Gino",
  "version": "0.3.0",
  "description": "A desk stretch coach that lives in your tray. Gino the Gnocchi pops up every 20 minutes of screen time.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "start": "tauri dev",
    "fast": "tauri dev -- -- --fast",
    "test": "npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "screens": "npm run build && electron build/dev/screens.js",
    "dist": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "electron": "^44.8.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
